# Environment Configuration Template
# Author: Aditya001-max <kaushikadityaraj001@gmail.com>

# Compute Device ("cpu", "cuda", "mps")
DEVICE=cpu

# Training Hyperparameters
RANDOM_SEED=42
DEFAULT_EPOCHS=100
DEFAULT_BATCH_SIZE=32
LEARNING_RATE=0.001

# Loss Component Weights
LAMBDA_DATA=1.0
LAMBDA_EQUILIBRIUM=0.5
LAMBDA_YIELD_STOICHIOMETRY=0.4
LAMBDA_NON_NEGATIVITY=0.1

# Logging & Monitoring
LOG_LEVEL=INFO
SAVE_CHECKPOINTS=True
CHECKPOINT_DIR=./checkpoints
